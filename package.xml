<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>crane_supervisor</name>
  <version>0.1.0</version>
  <description>Crane mode and health: a ROS-free decision core and the 20 Hz status stream over it.</description>
  <maintainer email="maintainers@example.invalid">Architecture maintainers</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- The status stream, the two inputs it carries end to end, and the one
       acknowledgement it serves. Nothing that reaches a command interface is
       here, and nothing that reaches one may be added: stop authority is
       withheld until the hardware stop input is verified, and
       test/test_no_command_path.py holds this list to that.

       `epsilon_crane_msgs` is the machine-telemetry boundary the new stack
       keeps rather than a new dependency of its own (ROS 2 Interfaces §9), and
       it is what `/crane/remote_ctrl_states` is typed with. `std_srvs` is the
       type ROS 2 Interfaces §5 gives `/crane/clear_fault`; a service is not a
       command path, and the guard test names the one this package may serve.

       `control_msgs` is ros2_control's own message set, which the Libraries
       page carries as part of ros2_control rather than package by package. The
       one type taken from it, `JointTrajectoryControllerState`, is what the
       forked trajectory controller already publishes about itself. It is read
       and never sent: this package holds no `trajectory_msgs` type, no action
       client and no publisher on anything but its own status stream, and the
       guard test holds it to that. -->
  <depend>control_msgs</depend>
  <depend>crane_msgs</depend>
  <depend>epsilon_crane_msgs</depend>
  <depend>generate_parameter_library</depend>
  <depend>rclcpp</depend>
  <depend>std_srvs</depend>

  <!-- The one exception, and the reason it is here rather than anywhere else.
       ROS 2 Interfaces §5 puts `/controller_manager/switch_controller` behind
       the supervisor: mode changes go through it, not from the behaviour tree,
       and a stack in which two elements can switch controllers has no arbiter
       at all. This is the *message* package and not `controller_manager`
       itself: what is linked here are two service types, so the node calls the
       manager over the graph and holds no controller, no plugin and no
       hardware interface. The Libraries page carries the ros2_control message
       sets as part of ros2_control rather than package by package, exactly as
       it does for `control_msgs` above. The guard test names the two service
       types and no others. -->
  <depend>controller_manager_msgs</depend>

  <!-- The second exception, added by issue 054 on the same terms. ROS 2
       Interfaces §4's "One command path" ends by saying that which of the two
       producers is live is the supervisor's decision *alone* and that the two
       never drive at once; issue 053 made that a state of `crane_mpc` and left
       its `mode` parameter writable so that this node could move it. This is
       ROS 2's own parameter service interface, which the Libraries page carries
       as part of "ROS 2 Humble ... parameters" rather than as a library of its
       own, and it is declared explicitly rather than taken through `rclcpp` so
       that the reach is visible in the manifest the guard test reads. One
       service type, one parameter, and the guard names both. -->
  <depend>rcl_interfaces</depend>

  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>crane_model</test_depend>
  <!-- The in-process controller-manager harness of PRD "Seams" S5, the shape
       `crane_control` already uses: a real ControllerManager with mock
       hardware, driven by hand on the isolated domain `ralph/verify.sh` pins.
       Test-only, and it has to be: a switch is the one call that must never be
       issued against the machine's live graph by accident, so it is asserted
       against a manager inside the test process and never against a launch.
       `velocity_controllers` supplies the two real controllers the harness
       switches between; what matters about them is the claim they hold. -->
  <test_depend>controller_manager</test_depend>
  <test_depend>velocity_controllers</test_depend>

  <export><build_type>ament_cmake</build_type></export>
</package>
