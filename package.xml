<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>crane_supervisor</name>
  <version>0.1.0</version>
  <description>Crane mode and health: a ROS-free decision core and the 20 Hz status stream over it.</description>
  <maintainer email="maintainers@example.invalid">Architecture maintainers</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- The status stream, the two inputs it carries end to end, and the one
       acknowledgement it serves. Nothing that reaches a command interface is
       here, and nothing that reaches one may be added: stop authority is
       withheld until the hardware stop input is verified, and
       test/test_no_command_path.py holds this list to that.

       `epsilon_crane_msgs` is the machine-telemetry boundary the new stack
       keeps rather than a new dependency of its own (ROS 2 Interfaces §9), and
       it is what `/crane/remote_ctrl_states` is typed with. `std_srvs` is the
       type ROS 2 Interfaces §5 gives `/crane/clear_fault`; a service is not a
       command path, and the guard test names the one this package may serve.

       `control_msgs` is ros2_control's own message set, which the Libraries
       page carries as part of ros2_control rather than package by package. The
       one type taken from it, `JointTrajectoryControllerState`, is what the
       forked trajectory controller already publishes about itself. It is read
       and never sent: this package holds no `trajectory_msgs` type, no action
       client and no publisher on anything but its own status stream, and the
       guard test holds it to that. -->
  <depend>control_msgs</depend>
  <depend>crane_msgs</depend>
  <depend>epsilon_crane_msgs</depend>
  <depend>generate_parameter_library</depend>
  <depend>rclcpp</depend>
  <depend>std_srvs</depend>

  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>crane_model</test_depend>

  <export><build_type>ament_cmake</build_type></export>
</package>
