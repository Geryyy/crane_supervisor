<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>crane_supervisor</name>
  <version>0.1.0</version>
  <description>Crane mode and health: a ROS-free decision core and the 20 Hz status stream over it.</description>
  <maintainer email="maintainers@example.invalid">Architecture maintainers</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- The status stream and the one input it carries end to end. Nothing that
       reaches a command interface is here, and nothing that reaches one may be
       added: stop authority is withheld until the hardware stop input is
       verified, and test/test_no_command_path.py holds this list to that. -->
  <depend>crane_msgs</depend>
  <depend>generate_parameter_library</depend>
  <depend>rclcpp</depend>

  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>crane_model</test_depend>

  <export><build_type>ament_cmake</build_type></export>
</package>
